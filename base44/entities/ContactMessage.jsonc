{
  "name": "ContactMessage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "email": {
      "type": "string",
      "description": "Email do cliente"
    },
    "phone": {
      "type": "string",
      "description": "Telefone do cliente"
    },
    "message": {
      "type": "string",
      "description": "Mensagem do cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "novo",
        "lido",
        "respondido"
      ],
      "default": "novo"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}